# Local-development values only. Never reuse these credentials outside local Compose.
APP_ENV=local
SERVICE_VERSION=0.1.0
PORT=8080
IDENTITY_ORIGIN=http://localhost:8080
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
TRUSTED_PROXY_CIDRS=[]
MAX_REQUEST_BODY_BYTES=16384
LOG_LEVEL=INFO
LOG_FORMAT=console
METRICS_ENABLED=true
COGNITO_ISSUER=http://127.0.0.1:9000/test-pool
COGNITO_JWKS_URL=http://127.0.0.1:9000/test-pool/.well-known/jwks.json
COGNITO_USERINFO_URL=http://127.0.0.1:9000/oauth2/userInfo
COGNITO_ALLOWED_CLIENT_IDS=["replace-with-local-test-client"]
OAUTH_RESOURCE=identity-service://api
OAUTH_PROFILE_READ_SCOPE=identity-service://api/profile.read
OAUTH_PROFILE_WRITE_SCOPE=identity-service://api/profile.write
JWT_CLOCK_SKEW_SECONDS=60
JWT_MAX_TOKEN_BYTES=16384
JWKS_CACHE_MAX_AGE_SECONDS=300
JWKS_STALE_IF_ERROR_SECONDS=1800
JWKS_REFRESH_MIN_INTERVAL_SECONDS=10
JWKS_NEGATIVE_KID_CACHE_SECONDS=10
JWKS_MAX_KEYS=16
UPSTREAM_CONNECT_TIMEOUT_SECONDS=2
UPSTREAM_READ_TIMEOUT_SECONDS=3
UPSTREAM_WRITE_TIMEOUT_SECONDS=3
UPSTREAM_POOL_TIMEOUT_SECONDS=2
UPSTREAM_MAX_RESPONSE_BYTES=65536
DATABASE_URL=postgresql+psycopg://identity_service_app:localapp@localhost:55432/identity_service # pragma: allowlist secret (fixed disposable local credential)
# Local/test may deliberately use a Unix-domain socket. Deployed environments may not.
# Deployed shape: postgresql+psycopg://database.example/identity_service?sslmode=verify-full
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=2000
DB_CONNECT_TIMEOUT_SECONDS=3
GRACEFUL_SHUTDOWN_SECONDS=15
ENABLE_INTERACTIVE_DOCS=true

# Standalone reference BFF local-development values.
BFF_ORIGIN=http://localhost:8081
BFF_CLIENT_ID=replace-with-local-reference-client
BFF_CLIENT_SECRET=replace-with-local-reference-secret # pragma: allowlist secret (local placeholder)
AUTHORIZATION_ENDPOINT=http://127.0.0.1:9000/oauth2/authorize
REQUESTED_SCOPES=["openid","identity-service://api/profile.read","identity-service://api/profile.write"]
REDIS_URL=redis://127.0.0.1:56379/15
REDIS_KEY_NAMESPACE=reference-bff:local:development
OAUTH_TRANSACTION_TTL_SECONDS=300
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_OPERATION_TIMEOUT_SECONDS=2
